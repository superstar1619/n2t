// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
        Register(in=outd, load=true, out=out, out=outa);
        Inc16(in=outa, out=outa1);
        Mux16(a=outa, b=outa1, sel=inc, out=outb);
        Mux16(a=outb, b=in, sel=load, out=outc);
        Mux16(a=outc, b[0..15]=false , sel=reset, out=outd);
}